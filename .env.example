# ============================================================
# MOMENTUM AI 2.0 - ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================
# NOTE: The application is fully functional in development and
# demo mode without these keys (using deterministic heuristic engines
# and RevenueCat sandbox simulation).
#
# When deploying to production stores:
# 1. Copy this file to .env.local
# 2. Never commit .env.local to version control
# ============================================================

# 1. REVENUECAT (Monetization & Entitlements)
# Required for: Live App Store / Google Play in-app purchases & entitlement sync
# Obtain from: https://app.revenuecat.com/ -> Project Settings -> API Keys -> Public SDK Key
VITE_REVENUECAT_PUBLIC_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxxxx

# 2. GOOGLE GEMINI (AI Provider)
# Required for: Live generative reasoning beyond the built-in local deterministic compiler
# Obtain from: https://aistudio.google.com/ -> Get API Key
VITE_GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 3. ONESIGNAL (Push & Retention Journeys)
# Required for: Production push notifications to physical mobile devices
# Obtain from: https://onesignal.com/ -> App Settings -> Keys & IDs
VITE_ONESIGNAL_APP_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# 4. STRIPE (Web-to-App Funnel)
# Required for: Live credit card processing on web checkout landing page
# Obtain from: https://dashboard.stripe.com/apikeys -> Publishable key
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 5. LAYERS (Growth Experimentation)
# Required for: Live K-factor telemetry and viral conversion analytics
# Obtain from: https://layers.app/ -> Project Settings -> SDK Key
VITE_LAYERS_API_KEY=layers_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx